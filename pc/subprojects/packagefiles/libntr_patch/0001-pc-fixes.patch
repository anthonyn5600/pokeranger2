+// For the PC port's own renderer (ntrgfx), until it has its own 3D: this frame's 3D picture, 256x192 RGBA, top row
+// first
+extern "C" void SIM_Read3DImage(u8 *rgba) {
+  static u8 pixels[SIM_NDS_SCREEN_WIDTH * SIM_NDS_SCREEN_HEIGHT * 4];
+  SIM_Read3DPixels(pixels);
+  for (int y = 0; y < SIM_NDS_SCREEN_HEIGHT; y++) {
+    memcpy(&rgba[y * SIM_NDS_SCREEN_WIDTH * 4], &pixels[(SIM_NDS_SCREEN_HEIGHT - 1 - y) * SIM_NDS_SCREEN_WIDTH * 4],
+           SIM_NDS_SCREEN_WIDTH * 4);
+  }
+}
