+
+// Display capture (DISPCAPCNT), capture mode A with source A = 3D only: copies this frame's 3D image into the
+// destination VRAM bank in LCDC memory (s_HW_LCDC_VRAM) as RGB555 with the alpha bit, then clears the enable bit as
+// the hardware does after one frame. The 3D image is first scaled down to 256x192 on the GPU.
+static bool s_g3ViewportOnTop;
+static GLuint s_captureFrameBuffer;
+static GLuint s_captureRenderBuffer;
+
+// The 3D picture scaled down to 256x192 RGBA (GL order: bottom row first)
+static void SIM_Read3DPixels(u8 *pixels) {
+  int scale = s_SIM_config.internalResolutionScale;
+  GLint drawBinding, readBinding;
+  glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &drawBinding);
+  glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &readBinding);
+  if (s_captureFrameBuffer == 0) {
+    glGenFramebuffers(1, &s_captureFrameBuffer);
+    glGenRenderbuffers(1, &s_captureRenderBuffer);
+    glBindRenderbuffer(GL_RENDERBUFFER, s_captureRenderBuffer);
+    glRenderbufferStorage(GL_RENDERBUFFER, GL_RGBA8, SIM_NDS_SCREEN_WIDTH, SIM_NDS_SCREEN_HEIGHT);
+    glBindFramebuffer(GL_FRAMEBUFFER, s_captureFrameBuffer);
+    glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, s_captureRenderBuffer);
+    glBindRenderbuffer(GL_RENDERBUFFER, 0);
+  }
+  int srcY = s_g3ViewportOnTop ? SIM_NDS_SCREEN_HEIGHT * scale : 0;
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, g3FrameBuffer);
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER, s_captureFrameBuffer);
+  glBlitFramebuffer(0, srcY, SIM_NDS_SCREEN_WIDTH * scale, srcY + SIM_NDS_SCREEN_HEIGHT * scale, 0, 0,
+                    SIM_NDS_SCREEN_WIDTH, SIM_NDS_SCREEN_HEIGHT, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, s_captureFrameBuffer);
+  glPixelStorei(GL_PACK_ALIGNMENT, 1);
+  glReadPixels(0, 0, SIM_NDS_SCREEN_WIDTH, SIM_NDS_SCREEN_HEIGHT, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+  // Back to what was bound before
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER, drawBinding);
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, readBinding);
+}
+
+// Set once the PC port's own renderer (ntrgfx) draws the screens: it does display capture itself
+static bool s_extRendererActive;
+
+static void SIM_DisplayCapture() {
+  u32 cap = s_reg_GX_DISPCAPCNT;
+  if (s_extRendererActive || !(cap & 0x80000000) || ((cap >> 29) & 3) != 0 || !((cap >> 24) & 1)) {
+    return;
+  }
+  static const int sizes[4][2] = {{128, 128}, {256, 64}, {256, 128}, {256, 192}};
+  int w = sizes[(cap >> 20) & 3][0];
+  int h = sizes[(cap >> 20) & 3][1];
+  u8 *bank = &s_HW_LCDC_VRAM[((cap >> 16) & 3) * 0x20000];
+  u32 offset = ((cap >> 18) & 3) * 0x8000;
+  static u8 pixels[SIM_NDS_SCREEN_WIDTH * SIM_NDS_SCREEN_HEIGHT * 4];
+  SIM_Read3DPixels(pixels);
+
+  for (int y = 0; y < h; y++) {
+    // GL rows go bottom to top
+    const u8 *row = &pixels[(SIM_NDS_SCREEN_HEIGHT - 1 - y) * SIM_NDS_SCREEN_WIDTH * 4];
+    for (int x = 0; x < w; x++) {
+      const u8 *px = &row[x * 4];
+      u16 color = (u16)((px[0] >> 3) | ((px[1] >> 3) << 5) | ((px[2] >> 3) << 10) | (px[3] ? 0x8000 : 0));
+      *(u16 *)&bank[(offset + (y * w + x) * 2) & 0x1FFFF] = color;
+    }
+  }
+  s_reg_GX_DISPCAPCNT = cap & ~0x80000000;
+}
