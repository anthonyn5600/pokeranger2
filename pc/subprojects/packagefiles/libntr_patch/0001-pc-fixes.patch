+// Shows a 256x384 RGBA picture in the current viewport (vertical screen layout)
+static void SIM_PresentExtFrame(const u8 *rgba) {
+  static GLuint tex, program, vao;
+  if (program == 0) {
+    const char *vs = "#version 330 core\n"
+                     "out vec2 uv;\n"
+                     "void main() {\n"
+                     "  vec2 p = vec2((gl_VertexID & 1) * 2.0 - 1.0, (gl_VertexID >> 1) * 2.0 - 1.0);\n"
+                     "  uv = vec2(p.x * 0.5 + 0.5, 0.5 - p.y * 0.5);\n"
+                     "  gl_Position = vec4(p, 0.0, 1.0);\n"
+                     "}\n";
+    const char *fs = "#version 330 core\n"
+                     "in vec2 uv;\n"
+                     "out vec4 color;\n"
+                     "uniform sampler2D frame;\n"
+                     "void main() { color = texture(frame, uv); }\n";
+    GLuint v = glCreateShader(GL_VERTEX_SHADER);
+    glShaderSource(v, 1, &vs, NULL);
+    glCompileShader(v);
+    GLuint f = glCreateShader(GL_FRAGMENT_SHADER);
+    glShaderSource(f, 1, &fs, NULL);
+    glCompileShader(f);
+    program = glCreateProgram();
+    glAttachShader(program, v);
+    glAttachShader(program, f);
+    glLinkProgram(program);
+    glDeleteShader(v);
+    glDeleteShader(f);
+    glGenVertexArrays(1, &vao);
+    glGenTextures(1, &tex);
+    glBindTexture(GL_TEXTURE_2D, tex);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+  }
+  glActiveTexture(GL_TEXTURE0);
+  glBindTexture(GL_TEXTURE_2D, tex);
+  glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+  glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, SIM_NDS_SCREEN_WIDTH, SIM_NDS_SCREEN_HEIGHT * 2, 0, GL_RGBA,
+               GL_UNSIGNED_BYTE, rgba);
+  glUseProgram(program);
+  glUniform1i(glGetUniformLocation(program, "frame"), 0);
+  glDisable(GL_BLEND);
+  glBindVertexArray(vao);
+  glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+  glBindVertexArray(0);
+}
