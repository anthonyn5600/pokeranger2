@@ -1016,6 +1017,37 @@ BOOL GX_TrySetBankForLCDC (int lcdc)
 	return TRUE;
 }
 
+
+#ifdef SDK_PORT
+// Each engine has its own VRAM array on PC and bank switches only record the mapping. Banks C and D move between
+// LCDC (where display capture writes them, s_HW_LCDC_VRAM) and the sub engine's BG / OBJ memory: carry their contents
+// along when they are mapped there or taken away (the dual-screen 3D capture trick).
+static u16 sSimSubBgBanks;
+static u16 sSimSubObjBanks;
+
+static void SIMi_SyncSubVramBanks (void)
+{
+	if (gGXState.vramCnt.sub_bg != sSimSubBgBanks) {
+		if (sSimSubBgBanks == GX_VRAM_SUB_BG_128_C) {
+			memcpy(&s_HW_LCDC_VRAM[0x40000], s_HW_DB_BG_VRAM, 0x20000);
+		}
+		if (gGXState.vramCnt.sub_bg == GX_VRAM_SUB_BG_128_C) {
+			memcpy(s_HW_DB_BG_VRAM, &s_HW_LCDC_VRAM[0x40000], 0x20000);
+		}
+		sSimSubBgBanks = gGXState.vramCnt.sub_bg;
+	}
+	if (gGXState.vramCnt.sub_obj != sSimSubObjBanks) {
+		if (sSimSubObjBanks == GX_VRAM_SUB_OBJ_128_D) {
+			memcpy(&s_HW_LCDC_VRAM[0x60000], s_HW_DB_OBJ_VRAM, 0x20000);
+		}
+		if (gGXState.vramCnt.sub_obj == GX_VRAM_SUB_OBJ_128_D) {
+			memcpy(s_HW_DB_OBJ_VRAM, &s_HW_LCDC_VRAM[0x60000], 0x20000);
+		}
+		sSimSubObjBanks = gGXState.vramCnt.sub_obj;
+	}
+}
+#endif
+
 static inline void GxSetBankForSubBG (GXVRamSubBG sub_bg)
 {
 	GX_VRAM_SUB_BG_ASSERT(sub_bg);
@@ -1027,6 +1059,9 @@ static inline void GxSetBankForSubBG (GXVRamSubBG sub_bg)
 
 	GX_VRAMCNT_SetSubBG_(sub_bg);
 	GX_VRAMCNT_SetLCDC_(gGXState.vramCnt.lcdc);
+#ifdef SDK_PORT
+	SIMi_SyncSubVramBanks();
+#endif
 }
 
 void GX_SetBankForSubBG (GXVRamSubBG sub_bg)
@@ -1058,6 +1093,9 @@ static inline void GxSetBankForSubOBJ (GXVRamSubOBJ sub_obj)
 
 	GX_VRAMCNT_SetSubOBJ_(sub_obj);
 	GX_VRAMCNT_SetLCDC_(gGXState.vramCnt.lcdc);
+#ifdef SDK_PORT
+	SIMi_SyncSubVramBanks();
+#endif
 }
 
 void GX_SetBankForSubOBJ (GXVRamSubOBJ sub_obj)
@@ -1156,6 +1194,9 @@ static int resetBankForX_ (u16 *g3bit)
 	gGXState.vramCnt.lcdc |= rval;
 
 	GX_VRAMCNT_SetLCDC_(rval);
+#ifdef SDK_PORT
+	SIMi_SyncSubVramBanks();
+#endif
 	return rval;
 }
 
