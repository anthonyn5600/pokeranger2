+extern "C" void SIM_ReadPresentedScreens(u8 *rgba) {
+  int w, h;
+  SDL_GL_GetDrawableSize(window, &w, &h);
+  static std::vector<u8> pixels;
+  pixels.resize((size_t)w * h * 4);
+  GLint readBinding;
+  glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &readBinding);
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+  glReadBuffer(GL_BACK);
+  glPixelStorei(GL_PACK_ALIGNMENT, 1);
+  glReadPixels(0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, pixels.data());
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, readBinding);
+  for (int y = 0; y < SIM_NDS_SCREEN_HEIGHT * 2; y++) {
+    int sy = h - 1 - (y * h / (SIM_NDS_SCREEN_HEIGHT * 2));
+    for (int x = 0; x < SIM_NDS_SCREEN_WIDTH; x++) {
+      int sx = x * w / SIM_NDS_SCREEN_WIDTH;
